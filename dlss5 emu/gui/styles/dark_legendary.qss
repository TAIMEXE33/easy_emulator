QWidget#centralWidget {
    background-color: #0B0F19;
    color: #F8FAFC;
    font-family: 'Segoe UI', 'Cairo', sans-serif;
}

QLabel#mainTitle {
    font-size: 22px;
    font-weight: 800;
    color: #38BDF8;
}

QFrame#gameCard {
    background-color: #161E2E;
    border: 1px solid #2A374A;
    border-radius: 14px;
    padding: 16px;
}

QFrame#gameCard:hover {
    border-color: #38BDF8;
    background-color: #1E293B;
}

QPushButton#launchGameButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563EB, stop:1 #06B6D4);
    color: #FFFFFF;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px 16px;
    border: none;
}

QPushButton#launchGameButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1D4ED8, stop:1 #0891B2);
}

QPushButton#rtxBadgeButton {
    background-color: #064E3B;
    color: #34D399;
    border: 1px solid #059669;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: bold;
}

QPushButton#primaryActionButton {
    background-color: #3B82F6;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 6px 16px;
    font-weight: bold;
}